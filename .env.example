# ASEStats Mobile – környezeti változó sablon
# Másold `.env`-be és töltsd ki a Supabase projekt Settings → API oldaláról.
# FIGYELEM: az EXPO_PUBLIC_ prefixű változók bekerülnek a kliens bundle-be.
# Service role kulcs és AI kulcsok ide SOHA nem kerülhetnek.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
